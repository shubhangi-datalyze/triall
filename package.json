{
  "name": "datalyze-landing",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/content/registry.ts && tsx scripts/seo/lastmod.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/content/registry.ts && tsx scripts/seo/lastmod.ts && tsx scripts/content/check.ts && tsx scripts/playbook-links.ts && node pravix/scripts/sync-datalyze-tokens.mjs --check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "kb:migrate": "node scripts/kb/migrate.mjs",
    "kb:build": "tsx scripts/kb/build.mjs",
    "kb:verify": "tsx scripts/kb/verify.mjs",
    "kb:pages": "tsx scripts/kb/pages.mjs",
    "content:check": "tsx scripts/content/check.ts",
    "content:registry": "tsx scripts/content/registry.ts",
    "seo:lastmod": "tsx scripts/seo/lastmod.ts",
    "seo:check": "tsx scripts/seo/check-pages.ts",
    "responsive:check": "tsx scripts/responsive/check.ts",
    "images:frame": "node scripts/images/frame-method.mjs && node scripts/images/frame-services.mjs",
    "playbook:links": "tsx scripts/playbook-links.ts",
    "playbook:terms": "tsx scripts/playbook-terms.ts",
    "emails:table": "tsx --env-file=.env.local scripts/email-submissions.ts",
    "account:migrate": "tsx --env-file-if-exists=.env.local scripts/account-migrate.ts",
    "account:wipe": "tsx --env-file-if-exists=.env.local scripts/account-wipe.ts",
    "stripe:setup": "tsx --env-file-if-exists=.env.local scripts/stripe-setup.ts",
    "account:alerts": "tsx --env-file-if-exists=.env.local scripts/account-alerts.ts",
    "account:e2e": "tsx --env-file-if-exists=.env.local scripts/account-e2e.ts",
    "tracking-agent:links": "tsx --env-file-if-exists=.env.local scripts/tracking-agent-unconfirmed-links.ts",
    "playbook:migrate": "tsx --env-file=.env.local scripts/playbook-migrate.ts",
    "agent:knowledge": "tsx --env-file-if-exists=.env.local scripts/analytics-agent/build-knowledge.ts",
    "agent:embed": "tsx --env-file-if-exists=.env.local scripts/analytics-agent/build-knowledge.ts --embed-only",
    "agent:search": "tsx --env-file-if-exists=.env.local scripts/analytics-agent/search.ts",
    "agent:check": "tsx scripts/analytics-agent/check.ts",
    "agent:route-test": "tsx --env-file-if-exists=.env.local scripts/analytics-agent/route-test.ts",
    "agent:usage": "tsx scripts/analytics-agent/usage-report.ts",
    "test": "tsx --env-file-if-exists=.env.local --test tests/*.test.ts",
    "agent:gates-test": "tsx scripts/analytics-agent/gates-test.ts",
    "agent:gates-replay": "tsx scripts/analytics-agent/gates-replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@anthropic-ai/sdk": "^0.116.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google-cloud/bigquery": "^7.9.1",
    "@google-cloud/kms": "^5.7.0",
    "@google-cloud/storage": "^7.22.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@stripe/cli": "^1.53.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@vercel/functions": "^3.9.9",
    "blakejs": "1.2.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lz-string": "1.5.0",
    "mixpanel-browser": "^2.75.0",
    "next": "^15.1.0",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "stripe": "^23.0.0",
    "tweetnacl": "1.0.3",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/mixpanel-browser": "^2.50.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/config": "^0.5.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
